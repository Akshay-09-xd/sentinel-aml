# Set these environment variables in your shell before starting the server.
# The application does not load this file automatically.
# Defaults run the complete local demo without external services.
SENTINEL_GRAPH_BACKEND=local
# SENTINEL_DATA_DIR=/absolute/path/to/private/data
# SENTINEL_ENCRYPTION_KEY=<Fernet key stored in your secret manager>
# SENTINEL_SECURE_COOKIE=1
# Optional native graph backend. Use a dedicated Neo4j 5.26+ database.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<your local database password>
# NEO4J_DATABASE=neo4j
# Optional local language model. Pull the model in Ollama first.
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL=http://127.0.0.1:11434
